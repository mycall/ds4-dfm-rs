+// Digest only the tail after the last cached SHA-256 block. Ghosts contain
+// no token text, payload, media or adapter references. They guide eviction
+// only; the original prefix/LoRA checks still authorize every restore.
+static std::optional<server_tokens::prefix_hash> snapshot_key(const server_tokens & tokens,
+        const std::vector<common_adapter_lora_info> & lora) {
+    if (tokens.empty() || tokens.has_mtmd || !lora.empty()) return std::nullopt;
+    const auto & blocks = tokens.get_prefix_hashes();
+    const size_t done = blocks.size() * server_tokens::hash_block_size;
+    if (done > tokens.size() || tokens.size() - done >= server_tokens::hash_block_size) return std::nullopt;
+    server_tokens::prefix_hash prev{};
+    if (!blocks.empty()) prev = blocks.back();
+    std::array<uint8_t, sizeof(prev) + server_tokens::hash_block_size*sizeof(llama_token)> data;
+    const size_t tail = (tokens.size() - done)*sizeof(llama_token);
+    std::memcpy(data.data(), prev.data(), prev.size());
+    if (tail) std::memcpy(data.data() + prev.size(), tokens.get_tokens().data() + done, tail);
+    return hash_sha256(data.data(), prev.size() + tail);
+}
+
+void server_prompt_cache::evict() {
+    auto victim = states.begin();
+    if (history) {
+        size_t recent_bytes = 0;
+        for (const auto & state : states) {
+            if (state.prompt.cache_class == n1x_snapshot_class::recent) recent_bytes += state.size();
+        }
+        const auto cls = n1x_victim_class(history.get(), recent_bytes, limit_size);
+        const auto it = std::find_if(states.begin(), states.end(), [cls](const auto & s) {
+            return s.prompt.cache_class == cls;
+        });
+        if (it != states.end()) victim = it;
+        if (const auto key = snapshot_key(victim->prompt.tokens, victim->prompt.lora)) {
+            n1x_record_eviction(history.get(), key->data(), victim->size(), victim->prompt.cache_class, limit_size);
+        }
+    }
+    SRV_TRC(" - evicting %s snapshot (%.3f MiB)\n", victim->prompt.cache_class == n1x_snapshot_class::frequent ? "frequent" : "recent",
+            victim->size() / (1024.0 * 1024.0));
+    states.erase(victim);
+}
