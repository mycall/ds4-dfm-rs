+const void * llama_model::read_mapped_block(const void * src, size_t bytes, void * staging, size_t capacity,
+                                            ds41_expert_read * request) const {
+    const auto addr = reinterpret_cast<uintptr_t>(src);
+    for (const auto & map : pimpl->mappings) {
+        const auto base = reinterpret_cast<uintptr_t>(map->addr());
+        if (addr >= base && addr - base < map->size() && bytes <= map->size() - (addr - base)) {
+            return map->read_block(addr - base, bytes, staging, capacity, request);
+        }
+    }
+    return nullptr;
+}
