+const void * llama_mmap::read_block(size_t offset, size_t bytes, void * staging, size_t capacity,
+                                    ds41_expert_read * request) const {
+#if defined(_WIN32)
+    constexpr size_t sector = 4096;
+    const size_t prefix = offset % sector;
+    if (pimpl->direct == INVALID_HANDLE_VALUE || bytes > capacity || capacity - bytes < prefix + sector - 1) {
+        return nullptr;
+    }
+    const size_t start = offset - prefix;
+    const size_t length = (prefix + bytes + sector - 1) & ~(sector - 1);
+    if (length > UINT32_MAX) {
+        return nullptr;
+    }
+    if (request) {
+        if (request->start(pimpl->direct, start, staging, static_cast<DWORD>(length), prefix + bytes)) {
+            return static_cast<uint8_t *>(staging) + prefix;
+        }
+    } else {
+        ds41_expert_read local;
+        if (local.start(pimpl->direct, start, staging, static_cast<DWORD>(length), prefix + bytes) && local.finish()) {
+            return static_cast<uint8_t *>(staging) + prefix;
+        }
+    }
+#else
+    GGML_UNUSED(offset, bytes, staging, capacity, request);
+#endif
+    return nullptr;
+}
 
 void llama_mmap::unmap_fragment(size_t first, size_t last) { pimpl->unmap_fragment(first, last); }
 
