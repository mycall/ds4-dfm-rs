+void llama_moe_cache::prefetch_misses(ggml_backend_t backend, const ggml_tensor * w, const std::vector<bool> & used, int64_t n_tokens) const {
+    static const bool enabled = [] {
+        const char * setting = std::getenv("DS4_N1X_PREFETCH_WIDE");
+        if (!setting) {
+            setting = std::getenv("DS4_N1X_PREFETCH_EXPERTS");
+        }
+        return setting && std::strcmp(setting, "0") != 0;
+    }();
+    if (!enabled || n_tokens <= impl::max_batch) {
+        return;
+    }
+
+    const auto it = pimpl->bindings.find(w);
+    if (it == pimpl->bindings.end()) {
+        return;
+    }
+    const auto & binding = it->second;
+    const auto & group = pimpl->groups[pimpl->layers[binding.il].ig];
+    if (backend != pimpl->devices[group.id].backend) {
+        return;
+    }
+
+    // The slot map is stable during this copy. GPU hits do not need host pages.
+    const int32_t * slots = group.lru.slot_map[binding.il];
+    llama_memory_ranges ranges;
+    for (size_t e = 0; e < used.size(); ++e) {
+        if (used[e] && (!slots || slots[e] >= group.n_slots)) {
+            ranges.push_back({(const uint8_t *) w->data + e*w->nb[2], w->nb[2]});
+        }
+    }
+    llama_prefetch(std::move(ranges));
+}
+
 int64_t llama_moe_cache::copy_experts(ggml_backend_t backend, const ggml_tensor * w, ggml_tensor * dst, int64_t e, int64_t last) {
     return pimpl->copy_experts(backend, w, dst, e, last);
 }
