+void llama_moe_cache::seed_from_routes(ggml_backend_t backend, const ggml_tensor * w,
+        const ggml_tensor * routes, const int32_t * ids) {
+    static const bool enabled = [] {
+        const char * setting = std::getenv("DS4_N1X_SEED_EXPERTS");
+        return setting && std::strcmp(setting, "0") != 0;
+    }();
+    if (!enabled) {
+        return;
+    }
+    const auto it = pimpl->bindings.find(w);
+    if (it == pimpl->bindings.end()) {
+        return;
+    }
+    const int32_t il = it->second.il;
+    auto & layer = pimpl->layers[il];
+    auto & group = pimpl->groups[layer.ig];
+    if (layer.prompt_seeded || backend != pimpl->devices[group.id].backend) {
+        return;
+    }
+    layer.prompt_seeded = true;
+
+    // Keep existing entries. Shared banks leave each layer its share of empty slots.
+    auto & lru = group.lru;
+    const int32_t * slots = lru.slot_map[il];
+    if (!slots) {
+        return;
+    }
+    const int32_t resident = std::count_if(slots, slots + lru.n_expert, [&](int32_t s) { return s < group.n_slots; });
+    const int32_t quota = group.n_slots / (int32_t) group.layers.size();
+    const int32_t vacant = std::min(quota - resident, group.n_slots - lru.n_filled);
+    if (vacant <= 0) {
+        return;
+    }
+
+    std::vector<int32_t> frequency(lru.n_expert), candidates;
+    for (int64_t row = 0; row < routes->ne[1]; ++row) {
+        for (int64_t k = 0; k < routes->ne[0]; ++k) {
+            const int32_t id = ids[(row*routes->nb[1] + k*routes->nb[0])/sizeof(*ids)];
+            GGML_ASSERT(id >= 0 && id < lru.n_expert);
+            ++frequency[id];
+        }
+    }
+    for (int32_t e = 0; e < lru.n_expert; ++e) {
+        if (frequency[e] && slots[e] >= group.n_slots) {
+            candidates.push_back(e);
+        }
+    }
+    const size_t n = std::min<size_t>(vacant, candidates.size());
+    if (n == 0) {
+        return;
+    }
+    std::partial_sort(candidates.begin(), candidates.begin() + n, candidates.end(), [&](int32_t a, int32_t b) {
+        return frequency[a] != frequency[b] ? frequency[a] > frequency[b] : a < b;
+    });
+    size_t hits;
+    // Seed weights without advancing the decode clock or moving any work to the CPU.
+    GGML_ASSERT(lru.plan(il, candidates.data(), n, 0, 0, 0, [](size_t) { return size_t(0); },
+                pimpl->fills, pimpl->cpu, hits));
+    pimpl->upload_fills(backend, layer, group);
+}
