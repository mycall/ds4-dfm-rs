 // Baseline snapshots keep their original header. Looped snapshots bind both
 // ends of the repeated block, even when two experiments have the same depth.
 static uint32_t dsv4_state_version(const llama_hparams & hp) {
+    if (hp.dsv41_extra_layers > hp.dsv41_repeat_count) {
+        // Multi-repeat snapshots encode the end, width and added depth in ten bits each.
+        // The two low bits distinguish them from baseline and original single-repeat states.
+        static_assert(LLAMA_MAX_LAYERS < 1024);
+        return 2u | (uint32_t(hp.dsv41_repeat_at) << 2) | (uint32_t(hp.dsv41_repeat_count) << 12)
+                  | (uint32_t(hp.dsv41_extra_layers) << 22);
+    }
     return DSV4_STATE_VERSION | (uint32_t(hp.dsv41_repeat_at) << 8) | (uint32_t(hp.dsv41_repeat_count) << 20);
